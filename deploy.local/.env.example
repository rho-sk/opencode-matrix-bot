# opencode-matrix-bot — local configuration
# Copy this file to .env and fill in your values.

MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@opencode-bot:matrix.org
MATRIX_PASSWORD=secret_password
MATRIX_OWNER_ID=@yourname:matrix.org
OPENCODE_URL=http://localhost:4096
# OPENCODE_PASSWORD=

# Generate with: openssl rand -base64 32
MATRIX_PICKLE_KEY=change_this_to_a_random_secret
# MATRIX_CRYPTO_DB=
