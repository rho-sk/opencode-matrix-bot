# opencode-matrix-bot configuration
# Copy this file to .env and fill in the values.

# Matrix homeserver URL
MATRIX_HOMESERVER=https://matrix.org

# Matrix user ID of the bot account
MATRIX_USER_ID=@opencode-bot:matrix.org

# Password for the bot account
MATRIX_PASSWORD=secret_password

# Matrix user ID of the owner (only this user can interact with the bot)
MATRIX_OWNER_ID=@yourname:matrix.org

# URL of the local Opencode server (default: http://localhost:4096)
OPENCODE_URL=http://localhost:4096

# Optional: HTTP Basic Auth password for the Opencode server
# OPENCODE_PASSWORD=

# Key used to encrypt the local E2E crypto database (SQLite).
# Generate with: openssl rand -base64 32
# Required for end-to-end encryption support.
MATRIX_PICKLE_KEY=change_this_to_a_random_secret

# Optional: path to the E2E crypto SQLite database
# Default: ~/.local/share/opencode-matrix-bot/crypto.db
# MATRIX_CRYPTO_DB=
